{
  "name": "projectcraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "node scripts/backend.mjs",
    "build": "pnpm --dir frontend build",
    "start": "pnpm --dir frontend start",
    "lint": "pnpm --dir frontend lint",
    "type-check": "pnpm --dir frontend exec tsc --noEmit",
    "env:init": "node scripts/init-env.mjs",
    "test": "pnpm --dir frontend test",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests -q",
    "setup:backend": "node scripts/backend.mjs --setup",
    "test:e2e": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "playwright": "^1.65.0"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17"
    }
  }
}
